__pycache__/
*.py[cod]

# Per-user state. These live in %LOCALAPPDATA%\vram-planner (or
# ~/.local/share/vram-planner) as of v1.0.0; these entries catch pre-1.0 copies
# left beside the script. They identify your GPU and your model filenames and
# must never be committed.
vram_calibration.json
speed_history.json

# scratch
*.png
*.pdf

# Demo recordings. These are uploaded to GitHub (release or issue attachment)
# and linked from the README, never committed - git keeps every binary blob in
# history forever, and GitHub rejects any single file over 100 MB outright.
*.mp4
*.mov
*.webm
